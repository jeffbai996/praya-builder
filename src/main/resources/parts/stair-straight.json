{
  "schema_version": 1,
  "id": "stair.straight",
  "description": "A supported straight stair flight with a landing-length run.",
  "provenance": {"author": "Codex / gpt-5.6-terra", "project": "initial architectural vocabulary"},
  "style": "civic-modern",
  "parameters": {
    "rise": {"type": "integer", "min": 2, "max": 8, "default": 4},
    "width": {"type": "integer", "min": 1, "max": 3, "default": 2},
    "stair": {"type": "material", "default": "stair-up-south"},
    "support": {"type": "material", "default": "floor"},
