  "bounds": {"min": [0, -1, 0], "max": [{"param": "width"}, {"param": "rise"}, {"param": "rise", "offset": 1}]},
  "rotation": {"param": "facing", "turns": {"south": 0, "west": 1, "north": 2, "east": 3}},
  "components": [{"id": "flight", "role": "circulation", "origin": [0, 0, 0], "operations": [
    {"op": "box", "min": [0, -1, 0], "max": [{"param": "width"}, 0, {"param": "rise"}], "material": {"param": "support"}},
    {"op": "repeat", "count": {"param": "rise"}, "step": [0, 1, 1], "operations": [{"op": "box", "min": [0, 0, 0], "max": [{"param": "width"}, 1, 1], "material": {"param": "stair"}}]},
    {"op": "box", "min": [0, {"param": "rise", "offset": -1}, {"param": "rise"}], "max": [{"param": "width"}, {"param": "rise"}, {"param": "rise", "offset": 1}], "material": {"param": "support"}}
  ]}],
  "test": {"at": [4, 5, 4], "params": {}, "expect": {"valid": true}}
}
