    {"op": "box", "min": [0, {"param": "rise", "offset": -1}, {"param": "rise"}], "max": [{"param": "width", "scale": 2, "offset": 1}, {"param": "rise"}, {"param": "rise", "offset": 1}], "material": {"param": "support"}},
    {"op": "call", "part": "stair.straight", "at": [{"param": "width", "scale": 2}, {"param": "rise"}, {"param": "rise"}], "params": {"rise": {"param": "rise"}, "width": {"param": "width"}, "stair": {"param": "stair"}, "support": {"param": "support"}, "facing": "north"}}
  ]}],
  "test": {"at": [6, 5, 6], "params": {}, "expect": {"valid": true}}
}
